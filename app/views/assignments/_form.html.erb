<%= form_with(model: assignment, :url => assignment_form_path(assignment), :id => "assignment-form") do |form| %>
  <div class="modal-body">
    <div id="assignment-form-errors" style="color: red">
      <% if assignment.errors.any? %>
        <h2><%= pluralize(assignment.errors.count, "error") %> prohibited this assignment from being saved:</h2>

        <ul>
          <% assignment.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div>
      <%= form.label :title, class: "form-label" %>
      <%= form.text_field :title, :class => "form-control" %>
    </div>

    <div>
      <%= form.label :description, class: "form-label" %>
      <%= form.textarea :description, :class => "form-control" %>
    </div>

    <div>
      <%= form.label :due_date, class: "form-label" %>
      <%= form.datetime_field :due_date, :class => "form-control" %>
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <%= form.submit :class => "btn btn-primary" %>
  </div>
<% end %>
